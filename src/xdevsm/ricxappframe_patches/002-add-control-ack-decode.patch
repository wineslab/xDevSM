+class ControlAckMsg:
+    """
+    A class that parses the payload of an e2ap RICControlAcknowledge message.
+
+    The E2AP layer only carries the Service Model's octets; `control_outcome`
+    is opaque here and is decoded by whichever Service Model issued the
+    control request.
+    """
+
+    __slots__ = ('__request_id', '__instance_id', '__function_id',
+                 '__call_process_id', '__control_outcome')
+
+    def __init__(self):
+        self.__request_id = -1
+        self.__instance_id = -1
+        self.__function_id = -1
+        self.__call_process_id = b''
+        self.__control_outcome = b''
+
+    @property
+    def request_id(self):
+        return self.__request_id
+
+    @property
+    def instance_id(self):
+        return self.__instance_id
+
+    @property
+    def function_id(self):
+        return self.__function_id
+
+    @property
+    def call_process_id(self):
+        return self.__call_process_id
+
+    @property
+    def control_outcome(self):
+        return self.__control_outcome
+
+    def decode(self, payload: c_void_p):
+        """
+        Function that sets fields of ControlAckMsg class
+        through msg payload (bytes) of RICControlAcknowledge type.
+
+        Raise Exception when payload is not RICControlAcknowledge.
+
+        Parameters
+        ----------
+        payload: c_void_p
+            RICControlAcknowledge type payload received via rmr
+
+        Returns
+        -------
+        """
+        ack: control_ack_msg_t = _asn1_decode_controlAckMsg(
+            payload, getsizeof(payload))
+        if ack is None:
+            raise Exception("Payload is not matched with RICControlAcknowledge")
+
+        self.__request_id = ack.contents.request_id
+        self.__instance_id = ack.contents.instance_id
+        self.__function_id = ack.contents.function_id
+        if ack.contents.call_process_id and ack.contents.call_process_id_length:
+            self.__call_process_id = bytes(
+                ack.contents.call_process_id[:ack.contents.call_process_id_length])
+        if ack.contents.control_outcome and ack.contents.control_outcome_length:
+            self.__control_outcome = bytes(
+                ack.contents.control_outcome[:ack.contents.control_outcome_length])
+
+        _asn1_free_controlAckMsg(ack)
+        return
