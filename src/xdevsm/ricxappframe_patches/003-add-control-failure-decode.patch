+# Imported here, not in the import block at the top: patch 002 edits that line.
+from ricxappframe.e2ap.asn1clib.types import control_failure_msg_t  # noqa: E402
+
+_asn1_decode_controlFailureMsg = _wrap_asn1_function(
+    'e2ap_decode_ric_control_failure_message', POINTER(control_failure_msg_t), [c_void_p, c_ulong])
+_asn1_free_controlFailureMsg = _wrap_asn1_function(
+    'e2ap_free_decoded_ric_control_failure', c_void_p, [POINTER(control_failure_msg_t)])
+
+
+class ControlFailureMsg:
+    """
+    A class that parses the payload of an e2ap RICControlFailure message.
+
+    `cause_type` and `cause_value` are the E2AP Cause choice and its value.
+    As in ControlAckMsg, `control_outcome` is opaque here and is decoded by
+    whichever Service Model issued the control request.
+    """
+
+    __slots__ = ('request_id', 'instance_id', 'function_id', 'call_process_id',
+                 'control_outcome', 'cause_type', 'cause_value')
+
+    def __init__(self):
+        self.request_id = -1
+        self.instance_id = -1
+        self.function_id = -1
+        self.call_process_id = b''
+        self.control_outcome = b''
+        self.cause_type = 0
+        self.cause_value = -1
+
+    def decode(self, payload: bytes):
+        """
+        Set the fields from the bytes of a RICControlFailure received via rmr.
+
+        Raise Exception when payload is not RICControlFailure.
+        """
+        # len, not getsizeof: getsizeof also counts the bytes object header
+        failure = _asn1_decode_controlFailureMsg(payload, len(payload))
+        if not failure:
+            raise Exception("Payload is not matched with RICControlFailure")
+        msg = failure.contents
+        self.request_id = msg.request_id
+        self.instance_id = msg.instance_id
+        self.function_id = msg.function_id
+        if msg.call_process_id and msg.call_process_id_length:
+            self.call_process_id = bytes(msg.call_process_id[:msg.call_process_id_length])
+        if msg.control_outcome and msg.control_outcome_length:
+            self.control_outcome = bytes(msg.control_outcome[:msg.control_outcome_length])
+        self.cause_type = msg.cause_type
+        self.cause_value = msg.cause_value
+        _asn1_free_controlFailureMsg(failure)
+
+
